# Your Agent37 API key, from https://www.agent37.com/dashboard/cloud/api-keys
# The app uses it to create each user's agent, and `neon deploy` passes it to the
# clipper function, which wakes that agent when a video lands.
AGENT37_API_KEY=

# Everything else is written here by `neon deploy`: DATABASE_URL, the AWS_* Object
# Storage credentials for the videos bucket, and the AI Gateway credentials.

# Optional: the browser origins allowed to upload to the bucket, used by `npm run setup`.
# Add your deployed URL here before you run it again.
# APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
