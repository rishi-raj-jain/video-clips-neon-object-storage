{
  "name": "video-clips-neon-object-storage",
  "version": "1.0.0",
  "private": true,
  "description": "A video clipping app: uploads land in Neon Object Storage, a Function Trigger wakes the user's Agent37 agent to cut clips with ffmpeg, and the app serves the clips with presigned URLs",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "setup": "node --env-file=.env scripts/setup.mjs"
  },
