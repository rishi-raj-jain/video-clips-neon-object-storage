    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "hono": "^4.13.16",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.4",
